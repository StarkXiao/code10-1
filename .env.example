# ---- 运行时 ----
NODE_ENV=development
PORT=3000
# 对外访问来源（用于生成分享链接）。留空 = 按请求自动推断：
# 开发时是 http://localhost:5173，单端口部署时是同源地址。
WEB_ORIGIN=
TZ=Asia/Shanghai

# ---- 数据库 ----
# 开发默认 SQLite，零配置；生产可换成 PostgreSQL 连接串
# 注意：Prisma 对 SQLite 的 file: 相对路径是按 prisma/schema.prisma 所在目录解析的，
# 所以这里是 ../data/app.db → apps/server/data/app.db（= 仓库的运行时数据目录）
DATABASE_URL="file:../data/app.db"

# ---- 鉴权 ----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
SHARE_LINK_TTL_HOURS=72

# ---- 文件存储 ----
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backup
MAX_UPLOAD_MB=20

# ---- 定时任务 ----
CRON_ENABLED=true
CRON_SCHEDULE=0 * * * *

# ---- 通知渠道（可留空，留空即关闭） ----
SMTP_URL=
MAIL_FROM=
WEBHOOK_URL=
